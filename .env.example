# Copy this file to .env and fill in your own values.
# .env is gitignored on purpose — never commit real API keys or secrets.

# Only needed if a script talks to Gemini (e.g. for Reachy's speech).
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Only needed if you're connecting to a Reachy Mini over Wi-Fi instead of
# USB or the simulator. Use its IP address, not reachy-mini.local.
# REACHY_MINI_HOST=192.168.1.50

# Where `python -m eepy.behaviors.play` (and the BehaviorPlayer) sends motion:
#   dry   nothing moves; prints what would happen          (the default)
#   sim   the MuJoCo simulator, started on this machine
#   real  the real Reachy Mini, at REACHY_MINI_HOST
# --backend on the command line overrides this.
# EEPY_BACKEND=sim
