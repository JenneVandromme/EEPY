# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.eggs/
.pytest_cache/

# Virtual environments (see README — this project uses two, on purpose)
.venv/
.venv-vision/
.venv-robot/

# Local environment configuration (copy .env.example to .env to configure)
.env
.env.local

# AI / ML model weights and raw data — large binary files, don't commit them
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.pkl
data/
datasets/

# ...but the behaviour validator's vendored robot geometry IS source, not data.
# It is a 7.4 KB copy of reachy_mini/assets/kinematics_data.json, so CI can run
# the reachability check without installing the whole SDK. The 'data/' rule
# above would otherwise swallow it and the GitHub Action would fail with a
# confusing missing-file error.
!eepy/behaviors/data/
!eepy/behaviors/data/**

# IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# MuJoCo drops this in the working directory on simulator startup errors
MUJOCO_LOG.TXT
