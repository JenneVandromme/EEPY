# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.eggs/
.pytest_cache/

# Virtual environments (see README — this project uses two, on purpose)
.venv/
.venv-vision/
.venv-robot/
# Backups of old environments (e.g. .venv-vision-py39-backup)
/.venv-*/

# Local environment configuration (copy .env.example to .env to configure)
.env
.env.local
# The launcher's last choices (backend, mode, ports): per computer
/.launcher.json

# AI / ML model weights and raw data — large binary files, don't commit them
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.pkl
# data/ also holds every recorded session (data/sessions/): participant data,
# which must never be committed. tests/test_logs.py fails if this stops being so.
data/
datasets/

# ...but the behaviour validator's vendored robot geometry IS source, not data.
# It is a 7.4 KB copy of reachy_mini/assets/kinematics_data.json, so CI can run
# the reachability check without installing the whole SDK. The 'data/' rule
# above would otherwise swallow it and the GitHub Action would fail with a
# confusing missing-file error.
!eepy/behaviors/data/
!eepy/behaviors/data/**

# Generated speech audio and downloaded voice models (60 MB each). Both are
# rebuilt or re-downloaded on demand; neither belongs in git.
/.cache/

# Early pilot logs from the Wizard-of-Oz panel, before sessions moved to
# data/sessions/. Participant data: never commit.
# The leading slash matters: without it, "logs/" also matches eepy/logs/ -- the
# logging package's source code -- and silently drops it from git.
/logs/

# IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# MuJoCo drops this in the working directory on simulator startup errors
MUJOCO_LOG.TXT

# Report: the LaTeX, figures, results and drafts stay local. Only the scripts that
# reproduce the report's numbers and figures are tracked (report/scripts/*.py).
report/*
!report/scripts/
report/scripts/*
!report/scripts/*.py
